        border: 1px solid $warm-border;

        strong {
          color: $dark-brown;
          font-weight: 800;
        }
      }

      .speed-badge {
        font-size: 0.82rem;
        font-weight: 700;
        padding: 4px 10px;
        border-radius: $radius-sm;
        background: $olive-green-light;
        color: $olive-green;
        border: 1px solid $olive-green-border;
      }
    }
  }

  // Progress Bar Track
  .player-progress-track {
    width: 100%;
    height: 6px;
    background: $warm-beige;
    border-radius: 999px;
    overflow: hidden;
    position: relative;

    .player-progress-bar {
      height: 100%;
      background: linear-gradient(90deg, $tortilla-yellow, $terracotta);
      border-radius: 999px;
      transition: width 0.25s ease-out;
